<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= ebook.title || 'Ebook Reader' %></title>
    
    <!-- KaTeX CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <link rel="stylesheet" href="/css/style.css">

</head>
<body>
    <!-- Floating Action Button Menu -->
    <div class="fab-container">
        <div class="fab-options" id="fabOptions">
            <button class="fab-option" onclick="triggerAddNote()" style="--delay: 0.1s">
                <span class="option-label">Add Note</span>
                <span class="option-icon">📝</span>
            </button>
            <button class="fab-option" onclick="triggerHighlight()" style="--delay: 0.2s">
                <span class="option-label">Highlight</span>
                <span class="option-icon">🖍️</span>
            </button>
            <button class="fab-option" onclick="triggerShare()" style="--delay: 0.3s">
                <span class="option-label">Share</span>
                <span class="option-icon">📤</span>
            </button>
        </div>
        <button type="button" class="add-note-btn" id="addNoteBtn" onclick="toggleFabMenu()" title="Menu">+</button>
    </div>
    
    <!-- Note Form Popup -->
    <div class="note-form-popup" id="noteFormPopup">
        <h3>Add Note</h3>
        <textarea id="noteFormText" placeholder="Enter your note..."></textarea>
        <div class="note-form-actions">
            <button class="btn btn-secondary" onclick="cancelNoteForm()">Cancel</button>
            <button class="btn btn-primary" onclick="saveNoteForm()">Add Note</button>
        </div>
    </div>
    
    <div class="ebook-container">
        <!-- Notes Layer - inside container so it scrolls with content -->
        <div class="notes-layer" id="notesLayer"></div>
        
        <h1 class="ebook-title"><%= ebook.title || 'Ebook' %></h1>
        
        <% ebook.chapters.forEach(function(chapter) { %>
            <div class="chapter">
                <h2 class="chapter-title"><%= chapter.title %></h2>
                <div class="chapter-content" id="content-<%= chapter.id %>">
                    <!-- Content will be rendered here by JavaScript -->
                </div>
            </div>
        <% }); %>
    </div>
    
    <!-- Note Popup -->
    <div class="note-popup" id="notePopup">
        <button class="close-btn" onclick="closeNote()">&times;</button>
        <div class="note-title" id="noteTitle"></div>
        <div class="note-content" id="noteContent"></div>
    </div>
    
    <!-- KaTeX JavaScript -->
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    
    <script>
        // Ebook data passed from server
        const ebookData = <%- JSON.stringify(ebook) %>;
        const userId = '<%= userId %>';
        const initialUserNotes = <%- JSON.stringify(userNotes || []) %>;
        
        // User notes management
        let userNotes = [...initialUserNotes];
        let notesChanged = false;
        let noteIdCounter = Date.now();
        let currentEditingNote = null;
        let selectedText = null;
        let selectedPosition = null;
        let addNoteMode = false; // Make it global
        
        // Process and render content with highlights and KaTeX
        function renderContent() {
            ebookData.chapters.forEach(chapter => {
                const contentDiv = document.getElementById(`content-${chapter.id}`);
                if (!contentDiv) return;
                
                // Process text to handle highlights and KaTeX
                let processedContent = chapter.content;
                
                // Replace highlighted text with spans
                // Pattern 1: *display text*@noteId@ - display text shown, noteId used for lookup
                processedContent = processedContent.replace(
                    /\*([^*]+)\*@([^@]+)@/g, 
                    '<span class="highlight" data-term="$2" data-display="$1" onclick="showNote(\'$2\', this)">$1</span>'
                );
                
                // Pattern 2: *text* - highlighted text, note looked up by text
                processedContent = processedContent.replace(
                    /\*([^*]+)\*/g, 
                    '<span class="highlight" data-term="$1" onclick="showNote(\'$1\', this)">$1</span>'
                );
                
                // Pattern 3: @text@ - alternative highlighting syntax
                processedContent = processedContent.replace(
                    /@([^@]+)@/g, 
                    '<span class="highlight" data-term="$1" onclick="showNote(\'$1\', this)">$1</span>'
                );
                
                // Wrap content in a div for KaTeX rendering
                contentDiv.innerHTML = processedContent;
                
                // Render KaTeX math expressions
                renderMathInElement(contentDiv, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false},
                        {left: '\\[', right: '\\]', display: true},
                        {left: '\\(', right: '\\)', display: false}
                    ],
                    throwOnError: false
                });
            });
        }
        
        // Show note popup
        function showNote(term, element) {
            const notePopup = document.getElementById('notePopup');
            const noteTitle = document.getElementById('noteTitle');
            const noteContent = document.getElementById('noteContent');
            
            // Find note in ebookData.notes (case-insensitive search)
            const termLower = term.toLowerCase();
            let note = ebookData.notes[termLower];
            
            // Try to find with exact match or case-insensitive
            if (!note) {
                for (const key in ebookData.notes) {
                    if (key.toLowerCase() === termLower) {
                        note = ebookData.notes[key];
                        break;
                    }
                }
            }
            
            if (note) {
                // Use display text if available, otherwise use term
                const displayText = element ? element.getAttribute('data-display') : null;
                noteTitle.textContent = displayText || term;
                noteContent.textContent = note;
                
                // Position popup near clicked element
                const clickedElement = element || window.event.target;
                const rect = clickedElement.getBoundingClientRect();
                
                // Calculate position relative to viewport
                let top = rect.bottom + 10;
                let left = rect.left;
                
                // Adjust if popup goes off screen horizontally
                const popupWidth = 300; // Fixed width from CSS
                if (left + popupWidth > window.innerWidth) {
                    left = window.innerWidth - popupWidth - 20; // 20px padding from right
                }
                if (left < 10) left = 10; // 10px padding from left
                
                // Adjust if popup goes off screen vertically (show above if no space below)
                const popupHeight = 200; // Estimated height
                if (top + popupHeight > window.innerHeight) {
                    top = rect.top - popupHeight - 10;
                }
                
                notePopup.style.top = top + 'px';
                notePopup.style.left = left + 'px';
                
                notePopup.classList.add('active');
                
                // Add active class to clicked highlight
                document.querySelectorAll('.highlight').forEach(el => {
                    el.classList.remove('active');
                });
                clickedElement.classList.add('active');
            }
        }
        
        // Close note popup
        function closeNote() {
            const notePopup = document.getElementById('notePopup');
            notePopup.classList.remove('active');
            
            // Remove active class from all highlights
            document.querySelectorAll('.highlight').forEach(el => {
                el.classList.remove('active');
            });
        }
        
        // Close popup when clicking outside
        document.addEventListener('click', function(event) {
            const notePopup = document.getElementById('notePopup');
            if (notePopup && !notePopup.contains(event.target) && 
                !event.target.classList.contains('highlight')) {
                closeNote();
            }
        });
        
        // FAB Menu Functions
        function toggleFabMenu() {
            const btn = document.getElementById('addNoteBtn');
            const options = document.getElementById('fabOptions');
            btn.classList.toggle('active');
            options.classList.toggle('active');
        }

        function triggerAddNote() {
            console.log('Add Note triggered');
            addNoteMode = !addNoteMode;
            
            // Close menu
            toggleFabMenu();
            
            const container = document.querySelector('.ebook-container');
            
            if (addNoteMode) {
                container.style.cursor = 'crosshair';
                alert('Add Note Mode Enabled: Click anywhere on the ebook page to place a note.');
            } else {
                container.style.cursor = 'default';
            }
        }

        function triggerHighlight() {
            console.log('Highlight triggered');
            toggleFabMenu();
            alert('Highlight mode enabled. Select text to highlight.');
        }

        function triggerShare() {
            console.log('Share triggered');
            toggleFabMenu();
            if (navigator.share) {
                navigator.share({
                    title: document.title,
                    url: window.location.href
                }).catch(console.error);
            } else {
                alert('Share URL: ' + window.location.href);
            }
        }

        // --- Note System Implementation ---

        function initializeNotesSystem() {
            const container = document.querySelector('.ebook-container');
            
            // Handle clicks for adding notes
            container.addEventListener('click', function(e) {
                if (!addNoteMode) return;
                
                // Don't trigger if clicking on existing note or control
                if (e.target.closest('.sticky-note') || 
                    e.target.closest('.add-note-btn') || 
                    e.target.closest('.fab-container') ||
                    e.target.closest('.note-form-popup')) return;
                
                // Get coordinates relative to the container
                const rect = container.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                showNoteForm(x, y);
            });
        }

        function showNoteForm(x, y) {
            const popup = document.getElementById('noteFormPopup');
            const textarea = document.getElementById('noteFormText');
            
            selectedPosition = { x, y };
            textarea.value = '';
            
            // Position popup (fixed position)
            const container = document.querySelector('.ebook-container');
            const rect = container.getBoundingClientRect();
            
            // Calculate fixed position based on container position + relative click offset
            const fixedX = rect.left + x;
            const fixedY = rect.top + y;
            
            popup.style.left = Math.min(fixedX, window.innerWidth - 420) + 'px';
            popup.style.top = Math.min(fixedY, window.innerHeight - 300) + 'px';
            
            popup.classList.add('active');
            textarea.focus();
        }

        function cancelNoteForm() {
            document.getElementById('noteFormPopup').classList.remove('active');
            selectedPosition = null;
            currentEditingNote = null;
        }

        function saveNoteForm() {
            const text = document.getElementById('noteFormText').value.trim();
            if (!text) return;
            
            try {
                if (currentEditingNote) {
                    // Update existing
                    currentEditingNote.content = text;
                    currentEditingNote.updatedAt = new Date().toISOString();
                    
                    // Update DOM
                    const noteEl = document.getElementById(`note-${currentEditingNote.id}`);
                    if (noteEl) {
                        noteEl.querySelector('.sticky-note-content').textContent = text;
                    }
                    
                    currentEditingNote = null;
                } else {
                    // Create new
                    if (!selectedPosition) {
                        console.error('No position selected for new note');
                        return;
                    }

                    const newNote = {
                        id: 'note_' + Date.now(),
                        content: text,
                        x: selectedPosition.x,
                        y: selectedPosition.y,
                        createdAt: new Date().toISOString()
                    };
                    
                    userNotes.push(newNote);
                    renderSingleNote(newNote);
                }
                
                notesChanged = true;
                triggerAutosave();
            } catch (error) {
                console.error('Error saving note:', error);
                alert('Error saving note. See console for details.');
            } finally {
                cancelNoteForm();
                
                // Exit add mode
                addNoteMode = false;
                const container = document.querySelector('.ebook-container');
                if (container) container.style.cursor = 'default';
            }
        }

        function renderUserNotes() {
            const layer = document.getElementById('notesLayer');
            if (!layer) return;
            layer.innerHTML = '';
            userNotes.forEach(renderSingleNote);
        }

        function renderSingleNote(note) {
            const layer = document.getElementById('notesLayer');
            
            const noteEl = document.createElement('div');
            noteEl.className = 'sticky-note';
            noteEl.id = `note-${note.id}`;
            noteEl.style.left = note.x + 'px';
            noteEl.style.top = note.y + 'px';
            
            noteEl.innerHTML = `
                <div class="sticky-note-header">
                    <span class="sticky-note-title">Note</span>
                    <div class="sticky-note-actions">
                        <button class="note-btn edit" onclick="editNote('${note.id}')">✏️</button>
                        <button class="note-btn delete" onclick="deleteNote('${note.id}')">🗑️</button>
                    </div>
                </div>
                <div class="sticky-note-content">${escapeHtml(note.content)}</div>
            `;
            
            // Add drag functionality
            makeDraggable(noteEl, note.id);
            
            layer.appendChild(noteEl);
        }

        function makeDraggable(element, noteId) {
            let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
            const header = element.querySelector('.sticky-note-header');
            
            header.onmousedown = dragMouseDown;

            function dragMouseDown(e) {
                e.preventDefault();
                pos3 = e.clientX;
                pos4 = e.clientY;
                element.classList.add('dragging');
                document.onmouseup = closeDragElement;
                document.onmousemove = elementDrag;
            }

            function elementDrag(e) {
                e.preventDefault();
                pos1 = pos3 - e.clientX;
                pos2 = pos4 - e.clientY;
                pos3 = e.clientX;
                pos4 = e.clientY;
                
                const newTop = (element.offsetTop - pos2);
                const newLeft = (element.offsetLeft - pos1);
                
                element.style.top = newTop + 'px';
                element.style.left = newLeft + 'px';
                
                // Update note data
                const note = userNotes.find(n => n.id === noteId);
                if (note) {
                    note.x = newLeft;
                    note.y = newTop;
                    notesChanged = true;
                    triggerAutosave();
                }
            }

            function closeDragElement() {
                document.onmouseup = null;
                document.onmousemove = null;
                element.classList.remove('dragging');
            }
        }

        function editNote(id) {
            const note = userNotes.find(n => n.id === id);
            if (!note) return;
            
            currentEditingNote = note;
            document.getElementById('noteFormText').value = note.content;
            
            // Show popup near note
            const noteEl = document.getElementById(`note-${id}`);
            const rect = noteEl.getBoundingClientRect();
            
            const popup = document.getElementById('noteFormPopup');
            popup.style.left = rect.left + 'px';
            popup.style.top = rect.top + 'px';
            popup.classList.add('active');
        }

        function deleteNote(id) {
            if (!confirm('Delete this note?')) return;
            
            userNotes = userNotes.filter(n => n.id !== id);
            const noteEl = document.getElementById(`note-${id}`);
            if (noteEl) noteEl.remove();
            
            notesChanged = true;
            triggerAutosave();
        }

        let autosaveTimer = null;

        function triggerAutosave() {
            if (autosaveTimer) clearTimeout(autosaveTimer);
            
            // Optional: Show saving indicator
            
            autosaveTimer = setTimeout(() => {
                saveNotesToServer();
            }, 1000); // 1 second debounce
        }

        async function saveNotesToServer() {
            console.log('Autosaving notes for user:', userId);
            
            if (!userId) {
                console.error('Cannot save: User ID is missing');
                return;
            }

            try {
                const response = await fetch('/api/user-notes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ notes: userNotes, userId: userId })
                });
                
                const result = await response.json();
                
                if (response.ok) {
                    console.log('Autosaved successfully:', result);
                    notesChanged = false;
                } else {
                    console.error('Autosave failed:', result);
                    alert('Failed to save notes: ' + (result.error || response.statusText));
                }
            } catch (error) {
                console.error('Error autosaving:', error);
            }
        }
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        // Initialize when page loads
        function initializePage() {
            console.log('Initializing page...');
            renderContent();
            
            // Wait a bit for DOM to be fully ready
            setTimeout(function() {
                initializeNotesSystem();
                renderUserNotes();
                
                // Test if button exists
                const testBtn = document.getElementById('addNoteBtn');
                if (testBtn) {
                    console.log('✓ Add note button found!', testBtn);
                    // Add a simple test click handler
                    testBtn.addEventListener('click', function() {
                        console.log('TEST: Button clicked directly!');
                    });
                } else {
                    console.error('✗ Add note button NOT FOUND!');
                }
            }, 100);
        }
        
        if (document.readyState === 'loading') {
            window.addEventListener('DOMContentLoaded', function() {
                 if (typeof initializePage === 'function') {
                     initializePage();
                 }
            });
        } else {
             if (typeof initializePage === 'function') {
                 initializePage();
             }
        }
    </script>
    
    <!-- Custom JS -->
    <script src="/js/ebook.js"></script>
</body>
</html>
